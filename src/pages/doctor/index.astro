---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
---

<Layout title="Doctor Workspace - Secure PACS Portal">
  <Navbar />
  
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 relative z-10">
    <!-- Header Area -->
    <div class="flex flex-col md:flex-row md:items-center md:justify-between border-b border-slate-200 dark:border-slate-800 pb-6 mb-8 gap-4">
      <div>
        <div class="flex items-center gap-2 text-xs font-mono text-cyan-500 font-semibold uppercase tracking-wider mb-2">
          <span class="h-2 w-2 rounded-full bg-cyan-500 animate-ping"></span> Live PACS Connection Established
        </div>
        <h1 class="text-3xl font-extrabold font-display tracking-tight">Clinical Diagnosis Workspace</h1>
      </div>
      <div class="flex items-center gap-3">
        <div class="text-right hidden sm:block">
          <p class="text-sm font-bold font-display">Dr. K. Lesedi, MD</p>
          <p class="text-xs text-slate-500">Chief Radiologist | GHM-88</p>
        </div>
        <div class="h-10 w-10 rounded-full bg-gradient-to-tr from-cyan-500 to-blue-600 flex items-center justify-center font-bold text-white shadow-lg">KL</div>
      </div>
    </div>

    <!-- Main Workspace Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      
      <!-- Interactive DICOM Simulator Component -->
      <div class="lg:col-span-2 space-y-6">
        <div class="bg-slate-950 rounded-2xl p-4 border border-slate-800 shadow-2xl flex flex-col h-[550px]">
          <!-- PACS Toolbar -->
          <div class="flex items-center justify-between border-b border-slate-800 pb-3 mb-4 text-xs font-mono text-slate-400">
            <span class="flex items-center gap-2"><span class="h-2 w-2 rounded-full bg-red-500"></span> PATIENT: BRAIN_3T_082</span>
            <span class="hidden sm:inline">RESOLUTION: 1024x1024 · WINDOW: W:80 L:40</span>
          </div>

          <!-- Dynamic Medical Image Canvas -->
          <div class="flex-1 bg-black rounded-xl border border-slate-900 flex items-center justify-center relative overflow-hidden group">
            <canvas id="dicom-sim-canvas" aria-label="Simulated DICOM Medical Image Viewer" role="img" class="max-h-full max-w-full object-contain cursor-crosshair"></canvas>
            
            <!-- Crosshair Overlays -->
            <div class="absolute inset-0 pointer-events-none border border-cyan-500/10 hidden group-hover:block"></div>
            <div class="absolute top-1/2 left-0 right-0 h-px bg-cyan-500/10 pointer-events-none hidden group-hover:block"></div>
            <div class="absolute left-1/2 top-0 bottom-0 w-px bg-cyan-500/10 pointer-events-none hidden group-hover:block"></div>

            <!-- Dynamic UI Stats Overlay -->
            <div class="absolute bottom-4 left-4 font-mono text-[10px] text-cyan-400 bg-black/60 p-2 rounded border border-cyan-500/20 backdrop-blur-sm pointer-events-none">
              Zoom: <span id="canvas-zoom">100</span>%<br/>
              Contrast: <span id="canvas-contrast">Optimal</span>
            </div>
          </div>

          <!-- Viewport Interactive Controls -->
          <div class="grid grid-cols-4 gap-2 mt-4">
            <button id="pacs-zoom-in" class="bg-slate-900 hover:bg-slate-800 border border-slate-800 rounded-lg py-2 text-xs font-mono font-bold text-slate-200 hover:text-cyan-400 transition-all flex flex-col items-center gap-1">
              <span>🔍+</span> <span class="text-[10px] text-slate-500 font-normal">Zoom In</span>
            </button>
            <button id="pacs-zoom-out" class="bg-slate-900 hover:bg-slate-800 border border-slate-800 rounded-lg py-2 text-xs font-mono font-bold text-slate-200 hover:text-cyan-400 transition-all flex flex-col items-center gap-1">
              <span>🔍-</span> <span class="text-[10px] text-slate-500 font-normal">Zoom Out</span>
            </button>
            <button id="pacs-contrast-up" class="bg-slate-900 hover:bg-slate-800 border border-slate-800 rounded-lg py-2 text-xs font-mono font-bold text-slate-200 hover:text-cyan-400 transition-all flex flex-col items-center gap-1">
              <span>🌓+</span> <span class="text-[10px] text-slate-500 font-normal">Contrast</span>
            </button>
            <button id="pacs-reset" class="bg-slate-900 hover:bg-slate-800 border border-slate-800 rounded-lg py-2 text-xs font-mono font-bold text-slate-200 hover:text-cyan-400 transition-all flex flex-col items-center gap-1">
              <span>🔄</span> <span class="text-[10px] text-slate-500 font-normal">Reset</span>
            </button>
          </div>
        </div>
      </div>

      <!-- Triage & Anatomy Explorer Panel -->
      <div class="space-y-6">
        <!-- Interactive Anatomy Explorer Map -->
        <div class="bg-white dark:bg-slate-900 p-6 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-lg">
          <h2 class="text-lg font-bold font-display mb-4 flex items-center gap-2">
            <span>🧠</span> Anatomy Interactive Portal
          </h2>
          <p class="text-xs text-slate-500 dark:text-slate-400 mb-4">Click a diagnostic system below to isolate organ scan modalities and preview structures.</p>
          
          <div class="space-y-2">
            <button class="anatomy-btn w-full flex items-center justify-between p-3 rounded-xl bg-slate-50 dark:bg-slate-950 border border-slate-200/60 dark:border-slate-800/80 hover:border-cyan-500/30 text-left transition-all group" data-system="cerebral">
              <span class="font-semibold text-xs group-hover:text-cyan-500 transition-colors">Cerebral System (Brain)</span>
              <span class="text-xs font-mono text-slate-400">3T MRI</span>
            </button>
            <button class="anatomy-btn w-full flex items-center justify-between p-3 rounded-xl bg-slate-50 dark:bg-slate-950 border border-slate-200/60 dark:border-slate-800/80 hover:border-cyan-500/30 text-left transition-all group" data-system="thoracic">
              <span class="font-semibold text-xs group-hover:text-cyan-500 transition-colors">Thoracic Cavity (Lungs/Heart)</span>
              <span class="text-xs font-mono text-slate-400">Multi-slice CT</span>
            </button>
            <button class="anatomy-btn w-full flex items-center justify-between p-3 rounded-xl bg-slate-50 dark:bg-slate-950 border border-slate-200/60 dark:border-slate-800/80 hover:border-cyan-500/30 text-left transition-all group" data-system="abdominal">
              <span class="font-semibold text-xs group-hover:text-cyan-500 transition-colors">Abdominal Viscera</span>
              <span class="text-xs font-mono text-slate-400">Ultrasound</span>
            </button>
          </div>
        </div>

        <!-- Secure Clinical Referral Log -->
        <div class="bg-white dark:bg-slate-900 p-6 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-lg">
          <h2 class="text-lg font-bold font-display mb-4">Referrals & Triage</h2>
          <div class="divide-y divide-slate-100 dark:divide-slate-800/60">
            <div class="py-3 flex items-center justify-between">
              <div>
                <p class="font-semibold text-xs">Mokgosi, Tebogo</p>
                <p class="text-[10px] text-slate-500">MRI Brain · Gaborone Clinic</p>
              </div>
              <span class="px-2 py-0.5 bg-yellow-100 dark:bg-yellow-950 text-yellow-600 dark:text-yellow-400 text-[10px] font-bold rounded-full">Awaiting Report</span>
            </div>
            <div class="py-3 flex items-center justify-between">
              <div>
                <p class="font-semibold text-xs">Phiri, Lesedi</p>
                <p class="text-[10px] text-slate-500">CT Chest · GPH Hospital</p>
              </div>
              <span class="px-2 py-0.5 bg-green-100 dark:bg-green-950 text-green-600 dark:text-green-400 text-[10px] font-bold rounded-full">Completed</span>
            </div>
          </div>
        </div>
      </div>

    </div>
  </main>
</Layout>

<script>
  // PACs Canvas Simulator
  const canvas = document.getElementById('dicom-sim-canvas');
  if (canvas) {
    const ctx = canvas.getContext('2d');
    canvas.width = 400;
    canvas.height = 400;
    
    let zoomLevel = 100;
    let contrastLevel = 1;

    function renderScan() {
      if (!ctx) return;
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      ctx.fillStyle = 'black';
      ctx.fillRect(0, 0, canvas.width, canvas.height);

      // Simple abstract representation of a medical slice
      ctx.save();
      ctx.translate(canvas.width / 2, canvas.height / 2);
      ctx.scale(zoomLevel / 100, zoomLevel / 100);
      
      // Draw outer skull / structure
      ctx.beginPath();
      ctx.arc(0, 0, 100, 0, Math.PI * 2);
      ctx.strokeStyle = 'rgba(255, 255, 255, ' + (0.7 * contrastLevel) + ')';
      ctx.lineWidth = 4;
      ctx.stroke();

      // Brain lobes representation
      ctx.fillStyle = 'rgba(0, 200, 255, ' + (0.2 * contrastLevel) + ')';
      ctx.beginPath();
      ctx.arc(-30, -10, 45, 0, Math.PI * 2);
      ctx.arc(30, -10, 45, 0, Math.PI * 2);
      ctx.fill();

      ctx.restore();
    }

    renderScan();

    // Event hooks
    document.getElementById('pacs-zoom-in')?.addEventListener('click', () => {
      zoomLevel = Math.min(zoomLevel + 10, 200);
      document.getElementById('canvas-zoom').textContent = zoomLevel;
      renderScan();
    });

    document.getElementById('pacs-zoom-out')?.addEventListener('click', () => {
      zoomLevel = Math.max(zoomLevel - 10, 50);
      document.getElementById('canvas-zoom').textContent = zoomLevel;
      renderScan();
    });

    document.getElementById('pacs-contrast-up')?.addEventListener('click', () => {
      contrastLevel = contrastLevel >= 2 ? 0.5 : contrastLevel + 0.5;
      document.getElementById('canvas-contrast').textContent = contrastLevel === 0.5 ? 'Low' : contrastLevel === 1 ? 'Optimal' : 'High';
      renderScan();
    });

    document.getElementById('pacs-reset')?.addEventListener('click', () => {
      zoomLevel = 100;
      contrastLevel = 1;
      document.getElementById('canvas-zoom').textContent = '100';
      document.getElementById('canvas-contrast').textContent = 'Optimal';
      renderScan();
    });
  }
</script>