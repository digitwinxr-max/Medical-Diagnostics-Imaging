---
interface Props {
  title: string;
  description?: string;
}

const { title, description = "Gerald Holdings Medical Diagnostic Imaging - Immersive Clinical Platform" } = Astro.props;
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  
  <!-- Premium Fonts & Icons -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet" />
  
  <!-- Inline Fast Language Setter to prevent translation FOUC (flash of untranslated content) -->
  <script is:inline>
    (function() {
      const savedLang = localStorage.getItem('gerald_lang') || 'en';
      document.documentElement.lang = savedLang;
      document.documentElement.setAttribute('lang', savedLang);
    })();
  </script>
</head>
<body class="bg-slate-50 dark:bg-[#060b19] text-slate-800 dark:text-slate-100 font-sans min-h-screen flex flex-col transition-colors duration-300">
  
  <!-- Global Ambient Medical Scanning Grid (Creative Dynamic Background) -->
  <div class="fixed inset-0 pointer-events-none opacity-[0.02] dark:opacity-[0.05] bg-[linear-gradient(to_right,#808080_1px,transparent_1px),linear-gradient(to_bottom,#808080_1px,transparent_1px)] bg-[size:30px_30px] z-0"></div>
  
  <slot />

  <!-- SPA Global Page Loader -->
  <div id="global-page-loader" class="fixed inset-0 z-50 bg-[#060b19]/90 backdrop-blur-md flex items-center justify-center hidden opacity-0 transition-opacity duration-300">
    <div class="flex flex-col items-center gap-4">
      <div class="animate-spin rounded-full h-16 w-16 border-t-4 border-cyan-500 border-r-4"></div>
      <span class="text-cyan-400 font-mono font-semibold tracking-wider text-sm">LOADING SECURE CLINICAL PLATFORM...</span>
    </div>
  </div>

  <style is:global>
    :root {
      --font-sans: 'Plus Jakarta Sans', sans-serif;
      --font-display: 'Space Grotesk', sans-serif;
      --font-mono: 'JetBrains Mono', monospace;
    }
    
    body {
      font-family: var(--font-sans);
    }
    
    h1, h2, h3, h4, h5, h6 {
      font-family: var(--font-display);
    }
  </style>
</body>
</html>