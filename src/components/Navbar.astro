---
const navItems = [
  { name: "Home", path: "/", icon: "" },
  { name: "Services", path: "/services", icon: "" },
  { name: "Patient Portal", path: "/patient", icon: "" },
  { name: "Doctor Portal", path: "/doctor", icon: "" },
  { name: "Knowledge", path: "/knowledge", icon: "" },
  { name: "Enterprise", path: "/enterprise", icon: "" }
];
---

<header class="sticky top-0 z-40 w-full border-b border-slate-200/50 dark:border-slate-800/50 bg-white/80 dark:bg-[#060b19]/80 backdrop-blur-md transition-all">
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8">
    <!-- Brand Logo -->
    <a href="/" class="flex items-center gap-3 group">
      <div class="relative flex h-10 w-10 items-center justify-center rounded-xl bg-gradient-to-tr from-cyan-500 to-blue-600 shadow-lg shadow-cyan-500/20">
        <span class="text-white font-bold text-lg font-display">G</span>
        <!-- Medical pulse aesthetic -->
        <span class="absolute -right-0.5 -bottom-0.5 flex h-3 w-3">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-cyan-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-3 w-3 bg-cyan-500"></span>
        </span>
      </div>
      <span class="text-lg font-extrabold tracking-tight bg-clip-text text-transparent bg-gradient-to-r from-slate-900 via-slate-800 to-slate-700 dark:from-white dark:via-cyan-100 dark:to-cyan-400 font-display group-hover:opacity-80 transition-opacity">
        GERALD <span class="font-light text-cyan-500 dark:text-cyan-400">HOLDINGS</span>
      </span>
    </a>

    <!-- Desktop Navigation Links -->
    <nav class="hidden md:flex items-center gap-1">
      {navItems.map(item => (
        <a href={item.path} class="px-4 py-2 rounded-lg text-sm font-medium transition-all duration-200 text-slate-600 hover:text-slate-950 dark:text-slate-300 dark:hover:text-cyan-400 hover:bg-slate-50 dark:hover:bg-slate-900/50">
          {item.name}
        </a>
      ))}
    </nav>

    <!-- Right Utility Buttons -->
    <div class="flex items-center gap-3">
      <!-- Interactive Language Selector -->
      <select id="lang-selector" class="bg-slate-100 dark:bg-slate-900 text-slate-700 dark:text-slate-200 text-xs font-semibold py-1.5 px-3 rounded-lg border border-slate-200 dark:border-slate-800 focus:outline-none focus:ring-2 focus:ring-cyan-500">
        <option value="en">EN</option>
        <option value="tn">TN</option>
        <option value="fr">FR</option>
        <option value="de">DE</option>
      </select>

      <!-- Dark Mode Switcher -->
      <button id="theme-toggle" class="p-2 rounded-lg border border-slate-200 dark:border-slate-800 text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-900" aria-label="Toggle Dark Mode">
        <span class="dark:hidden">🌙</span>
        <span class="hidden dark:inline">☀️</span>
      </button>

      <!-- Mobile Menu Button -->
      <button id="mobile-menu-btn" class="md:hidden p-2 rounded-lg text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-900" aria-label="Toggle Mobile Menu">
        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Interactive Mobile Slide-Out Panel / Mobile App Navigation Dock -->
  <div id="mobile-nav-panel" class="hidden md:hidden fixed inset-x-0 top-16 bg-white dark:bg-[#060b19] border-b border-slate-200 dark:border-slate-800 p-4 transition-all shadow-xl">
    <div class="grid grid-cols-3 gap-3">
      {navItems.map(item => (
        <a href={item.path} class="flex flex-col items-center justify-center p-3 rounded-xl bg-slate-50 dark:bg-slate-900 hover:bg-cyan-500/10 dark:hover:bg-cyan-500/15 border border-slate-200/50 dark:border-slate-800/50 text-center group">
          <span class="text-lg mb-1 transition-transform group-hover:scale-110">{item.icon}</span>
          <span class="text-xs font-semibold text-slate-600 dark:text-slate-300 group-hover:text-cyan-500 dark:group-hover:text-cyan-400 font-display">{item.name}</span>
        </a>
      ))}
    </div>
  </div>
</header>

<script>
  // Mobile nav toggler script
  const btn = document.getElementById('mobile-menu-btn');
  const panel = document.getElementById('mobile-nav-panel');
  if (btn && panel) {
    btn.addEventListener('click', () => {
      panel.classList.toggle('hidden');
    });
  }
</script>